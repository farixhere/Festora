# ─────────────────────────────────────────────────────────────
# Festora environment variables. Copy to .env.local and fill in.
# Never commit real values. None of these use the NEXT_PUBLIC_ prefix,
# so none are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# REQUIRED — Neon pooled connection string (host contains "-pooler").
# Used by the running application on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# OPTIONAL but recommended for migrations — Neon DIRECT (non-pooled) string.
# Falls back to DATABASE_URL when unset.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# REQUIRED — session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# REQUIRED in production — public origin of the deployment (no trailing slash).
# On Vercel this is derived automatically if unset; set it when using a custom domain.
BETTER_AUTH_URL="http://localhost:3000"

# OPTIONAL — comma-separated Better Auth user IDs who may open /admin.
# Sign up first, copy your "Account ID" from Settings → Profile, then set it here.
PLATFORM_ADMIN_USER_IDS=""

# OPTIONAL — transactional email via Resend (password reset emails).
# Without these, password-reset emails are NOT sent and the UI says so.
RESEND_API_KEY=""
EMAIL_FROM="Festora <no-reply@your-domain.com>"

# OPTIONAL — Vercel Blob token enabling cover-image uploads.
# Without it, organizers choose built-in cover designs or paste an image URL.
BLOB_READ_WRITE_TOKEN=""
